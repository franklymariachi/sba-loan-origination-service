<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="001-create-loan-applications-table" author="jose.cervantes">
        <createTable tableName="loan_applications">
            <column name="id" type="UUID">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="business_name" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="requested_amount" type="DECIMAL(15,2)">
                <constraints nullable="false"/>
            </column>
            <column name="loan_purpose" type="VARCHAR(100)">
                <constraints nullable="false"/>
            </column>
            <column name="annual_revenue" type="DECIMAL(15,2)">
                <constraints nullable="false"/>
            </column>
            <column name="dscr_ratio" type="DECIMAL(5,2)">
                <constraints nullable="false"/>
            </column>
            <column name="status" type="VARCHAR(50)">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="TIMESTAMP"/>
        </createTable>

        <createIndex tableName="loan_applications" indexName="idx_loan_status">
            <column name="status"/>
        </createIndex>
    </changeSet>
</databaseChangeLog>